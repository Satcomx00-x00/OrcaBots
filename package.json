{
  "name": "orca-bots",
  "version": "0.1.0",
  "private": true,
  "description": "Importable Orca bots that watch your agents and your app.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "validate": "bun src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test && bun run validate"
  },
  "dependencies": {
    "croner": "11.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
